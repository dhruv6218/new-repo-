# Public Supabase project URL and publishable/anon key only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Never expose or commit a service-role key. Server-only operations should
# read it from the deployment secret manager when they are implemented.
# SUPABASE_SERVICE_ROLE_KEY=

# Server-only AI provider credentials. Never expose these with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_TONE_MODEL=gpt-4o-mini

# ==============================================================================
# Astrix AI Production Environment Variables Configuration
# ==============================================================================

# --- Supabase (Database & Authentication) ---
NEXT_PUBLIC_SUPABASE_URL=https://yamqqvofbpesownknzni.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
NEXT_PUBLIC_SITE_URL=https://astrixai.app

# --- AI Providers (Tone Cloning & Reminder Generation) ---
# Runtime order: Gemini -> Groq -> NVIDIA NIM -> OpenAI -> Rule-based fallback
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b # Free tier model (or qwen/qwen3.8-27b)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1/chat/completions
NVIDIA_MODEL=meta/llama-3.1-8b-instruct
OPENAI_API_KEY=
OPENAI_TONE_MODEL=gpt-4o-mini

# --- Transactional Email (Daily Chase Reminders) ---
# Used by Supabase Edge Function 'daily-chase'
REMINDER_FROM_EMAIL=reminders@astrixai.app
RESEND_API_KEY=
POSTMARK_SERVER_TOKEN=
CRON_SECRET=your_super_secret_cron_token

# --- Platform Billing (Dodo Payments) ---
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_SECRET=
DODO_PAYMENTS_ENV=test_mode # 'test_mode' or 'live_mode'
DODO_PRODUCT_SOLO_ID=p_solo_123
DODO_PRODUCT_AGENCY_ID=p_agency_123

# --- User Payment Gateways (Invoice Collection) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Gateway Key Encryption (AES-256-GCM) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required to encrypt user-provided Stripe/Razorpay/Dodo API keys at rest.
# If unset, only a SHA-256 hash reference is stored (keys cannot be decrypted).
GATEWAY_ENCRYPTION_KEY=

# --- Error Tracking (Optional but recommended for production) ---
NEXT_PUBLIC_SENTRY_DSN=

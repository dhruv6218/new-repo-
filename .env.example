# Public Supabase project URL and publishable/anon key only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=https://astrix.ai

# Optional provider-neutral analytics endpoint. Leave blank to keep analytics disabled.
NEXT_PUBLIC_ANALYTICS_ENDPOINT=

# Never expose or commit a service-role key. Server-only operations should
# read it from the deployment secret manager when they are implemented.
# SUPABASE_SERVICE_ROLE_KEY=

# Server-only AI provider credentials. Never expose these with NEXT_PUBLIC_.
# Runtime order: Gemini -> NVIDIA NIM -> OpenAI -> deterministic fallback
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1/chat/completions
NVIDIA_MODEL=meta/llama-3.1-8b-instruct
OPENAI_API_KEY=
OPENAI_TONE_MODEL=gpt-4o-mini
